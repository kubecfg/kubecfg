{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":maintainLockFilesWeekly",
    ":rebaseStalePrs",
    "docker:pinDigests",
    "group:linters",
    "group:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "forkProcessing": "disabled",
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Automerge trivial updates (Kodiak merges PRs labelled automerge)",
      "matchUpdateTypes": ["patch", "digest", "lockFileMaintenance"],
      "addLabels": ["automerge"]
    },
    {
      "description": "Kubernetes Go modules must move together (e.g. kube-openapi, kustomize and structured-merge-diff track the k8s.io release)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "groupName": "kubernetes"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["go-version: *(?<currentValue>.*?)\\n"],
      "depNameTemplate": "go",
      "depTypeTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "npm"
    }
  ]
}
