# Exercised by TestShowJamlet in cmd/show_test.go.
${local name = std.extVar('name')}
${local lib = import 'test.libsonnet'}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${name}
  labels:
    app: ${$.metadata.name}
data:
  kind: ${lib.kind}
  answer: ${std.toString(lib.number)}
  # import compiles with the jamlet: scheme, importstr reads the source.
  greeting: ${(import 'jamlet:jamlet_lib.jamlet').greeting}
  source: ${importstr 'jamlet_lib.jamlet'}
  shell: 'echo ${HOME}'
---
apiVersion: v1
kind: Namespace
metadata:
  name: ${name + '-ns'}
