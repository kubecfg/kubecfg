# The guestbook frontend (see guestbook.jsonnet) written in Jamlet: plain YAML
# where any value can be a ${...} Jsonnet expression.
#
#   kubecfg --alpha show examples/guestbook.jamlet
#
# See docs/Advanced-Usage/jamlet.md for the full spec.

# Local declarations scope over the rest of the file, i.e. every document below.
${local params = {
  replicas: 3,
  version: 'v3',
  env: {GET_HOSTS_FROM: 'dns', REDIS_HOST: 'redis-leader'},
}}
${local labels = {app: 'guestbook', tier: 'frontend'}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  labels: ${labels}
# An anchor on a mapping also names it in the expressions inside it.
spec: &spec
  # An expression keeps its type: 3, not "3".
  replicas: ${params.replicas}
  selector:
    matchLabels: ${labels}
  template:
    metadata:
      # `spec` is the anchored mapping above: the pods must match the selector.
      labels: ${spec.selector.matchLabels}
    spec:
      containers:
        # A local declaration inside a mapping is a local of that mapping.
        - ${local port = 80}
          name: php-redis
          # Strings are built in Jsonnet; an expression is always a whole value.
          image: ${'gcr.io/google-samples/gb-frontend:' + params.version}
          ports: [{containerPort: ${port}}]
          # Expressions may span lines and use any Jsonnet. Inside one, \{ followed
          # by a line break goes back to YAML, up to a } indented less than the YAML.
          env: ${[
            \{
              name: ${k}
              value: ${params.env[k]}
            }
            for k in std.objectFields(params.env)
          ] + [{name: 'PORT', value: std.toString(port)}]}
          volumeMounts: [{name: config, mountPath: /etc/guestbook}]
      volumes:
        - name: config
          configMap: {name: frontend-config}
---
apiVersion: v1
kind: Service
metadata:
  name: frontend
  # `$` is the root of the current YAML document, `self` the enclosing mapping.
  labels: ${$.spec.selector}
spec:
  type: LoadBalancer
  ports: [{port: 80}]
  selector: ${labels}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: frontend-config
data:
  # Strings are never interpolated, so shell ${VARIABLES} need no escaping.
  start.sh: |
    #!/bin/sh
    echo "starting on ${HOSTNAME}"
    exec apache2-foreground
  version: ${params.version}
  # A computed key; a key that evaluates to null drops the field.
  ${if params.replicas > 1 then 'ha.conf'}: ${|||
    sessions = redis
    replicas = %d
  ||| % params.replicas}
