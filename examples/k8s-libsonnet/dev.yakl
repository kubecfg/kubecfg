# Development: its own namespace, one replica each, debug logs.
#
#   kubecfg --features=yakl,overlay show shop.yakl --overlay-code-file dev.yakl

# Every object gets the namespace, and every container, Redis's included, gets
# the pull policy and LOG_LEVEL. A container that sets one of these itself keeps
# its own value: the library's types are the bottom layer.
!k8s+
ObjectMeta+:
  namespace: shop-dev
v1+:
  Container+:
    imagePullPolicy: Always
    env_+:
      LOG_LEVEL: {value: debug}
---
!config+
version: 1.5.0-rc.1
domain: shop.dev.example.com
replicas: {web: 1, api: 1}
