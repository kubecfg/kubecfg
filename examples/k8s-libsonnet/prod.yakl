# Production: its own namespace and nodes, more replicas, API resources, a
# disruption budget, and a bigger Redis.
#
#   kubecfg --alpha show shop.yakl --overlay-code-file prod.yakl

!k8s+
ObjectMeta+:
  namespace: shop-prod
v1+:
  # Every pod, Redis's too, runs on the shop's nodes.
  PodTemplateSpec+:
    spec+:
      nodeSelector: {example.com/pool: shop}
      tolerations: [{key: example.com/pool, value: shop, effect: NoSchedule}]
  # Every Service is scraped.
  Service+:
    metadata+:
      annotations+:
        prometheus.io/scrape: 'true'
---
!config+
replicas: {web: 3, api: 6}
---
# One container, by name.
!api+
spec+:
  template+:
    spec+:
      containers_+:
        api+:
          resources:
            requests: {cpu: 500m, memory: 512Mi}
            limits: {memory: 1Gi}
---
!api-pdb
<<+: ${$.k8s.policy.v1.PodDisruptionBudget}
metadata+:
  name: api
spec:
  maxUnavailable: 1
  selector: ${$.api.spec.selector}
---
!redis+
statefulset+:
  spec+:
    template+:
      spec+:
        containers_+:
          redis+:
            resources:
              requests: {memory: 2Gi}
    # Upstream's list has no names to extend by, so a loop changes every item.
    volumeClaimTemplates:
      - ${for t in super.volumeClaimTemplates}:
          <<+: ${t}
          spec+:
            resources+:
              requests+: {storage: 20Gi}
