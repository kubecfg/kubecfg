# A fake online shop: a web frontend, an API, a nightly worker and a Redis cache,
# built on k8s-libsonnet. See README.md.
#
#   kubecfg --features=yakl show shop.yakl
#   kubecfg --features=yakl,overlay show shop.yakl --overlay-code-file prod.yakl

# The library, plus a label for every shop object. It's a hidden field rather
# than a local key, so an overlay can extend it (^^+: k8s) and change every
# object built from it. Expressions read it as $.k8s, which follows overlays.
^^:: k8s
<<+: ${import 'k8s.libsonnet'}
ObjectTemplateMeta+:
  labels+:
    app.kubernetes.io/part-of: shop
---
^^:: config
registry: registry.example.com/shop
version: 1.4.2
domain: shop.example.com
replicas: {web: 2, api: 2}
---
'&image': ${function(name) $.config.registry + '/' + name + ':' + $.config.version}
---
# <<+ starts from the library's Deployment. The + on metadata, spec and template
# keeps what the library puts there, such as the namespace an overlay sets; a key
# without + would replace it. &labels names the labels for the whole document.
^^: web
<<+: ${$.k8s.apps.v1.Deployment}
metadata+:
  name: web
spec+:
  replicas: ${$.config.replicas.web}
  selector:
    matchLabels: &labels {app.kubernetes.io/name: web}
  template+:
    metadata+:
      labels+: ${labels}
    spec+:
      # The library's lists keyed by name: it writes containers: [{name: web, ...}].
      # An overlay changes one entry by its name.
      containers_+:
        web:
          image: ${image('web')}
          ports_+:
            http: {containerPort: 8080}
          env_+:
            API_URL: {value: 'http://api'}
---
^^: web-svc
<<+: ${$.k8s.v1.Service}
metadata+:
  name: web
spec+:
  selector: ${$.web.spec.selector.matchLabels}
  ports_+:
    http: {port: 80, targetPort: http}
---
^^: api
<<+: ${$.k8s.apps.v1.Deployment}
metadata+:
  name: api
spec+:
  replicas: ${$.config.replicas.api}
  selector:
    matchLabels: &labels {app.kubernetes.io/name: api}
  template+:
    metadata+:
      labels+: ${labels}
    spec+:
      containers_+:
        api:
          image: ${image('api')}
          ports_+:
            http: {containerPort: 8080}
          env_+:
            REDIS_URL: {value: 'redis://redis:6379'}
---
^^: api-svc
<<+: ${$.k8s.v1.Service}
metadata+:
  name: api
spec+:
  selector: ${$.api.spec.selector.matchLabels}
  ports_+:
    http: {port: 80, targetPort: http}
---
^^: worker
<<+: ${$.k8s.batch.v1.CronJob}
metadata+:
  name: worker
spec+:
  schedule: '0 3 * * *'
  jobTemplate+:
    spec+:
      template+:
        spec+:
          restartPolicy: OnFailure
          containers_+:
            worker:
              image: ${image('api')}
              args: [reindex]
              # The API's variables, with an overlay's changes to them.
              env_+: ${$.api.spec.template.spec.containers_.api.env_}
---
^^: ingress
<<+: ${$.k8s['networking.k8s.io'].v1.Ingress}
metadata+:
  name: shop
spec:
  rules:
    - host: ${$.config.domain}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: {name: web, port: {name: http}}
          - path: /api
            pathType: Prefix
            backend:
              service: {name: api, port: {name: http}}
---
# Redis as published upstream. adopt turns its objects into library objects, so
# overlays reach them too. Keyed by kind, so an overlay can pick one.
^^: redis
<<+: |-
  ${$.k8s.adopt({
    [std.asciiLower(o.kind)]: o
    for o in std.parseYaml(importstr 'redis.yaml')
  })}
